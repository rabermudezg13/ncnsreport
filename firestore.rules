rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function active(){return signedIn() && profile().active == true;}
  function roleIs(role){return active() && profile().role == role;}
  function admin(){return roleIs('admin');}
  function manager(){return roleIs('manager');}
  function staff(){return roleIs('staff');}
  function editor(){return admin() || manager();}
  function writer(){return editor() || staff();}
  match /users/{uid} {
    allow read: if active() && (admin() || request.auth.uid == uid);
    allow create: if (signedIn()
      && request.auth.uid == uid
      && request.resource.data.keys().hasOnly(['firstName','lastName','email','role','active','createdAt','updatedAt'])
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.role == 'staff'
      && request.resource.data.active == true
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time) || admin();
    allow update,delete: if admin();
  }
  match /substitutes/{id} { allow read: if active(); allow create,update: if writer(); allow delete: if admin();
    match /notes/{noteId} { allow read: if active(); allow create: if writer() && request.resource.data.createdBy == request.auth.uid; allow update,delete: if admin() || (writer() && resource.data.createdBy == request.auth.uid); }
  }
  match /incidents/{id} { allow read: if active(); allow create: if writer() && request.resource.data.createdBy == request.auth.uid && request.resource.data.incidentType in ['no_call_no_show','late_cancellation']; allow update: if editor() && request.resource.data.incidentType in ['no_call_no_show','late_cancellation']; allow delete: if admin(); }
  match /schools/{id} { allow read: if active(); allow write: if editor(); }
  match /settings/{id} { allow read: if active(); allow write: if admin(); }
}}
